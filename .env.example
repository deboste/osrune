# OSRune - variables d'environnement (Phase 0 + 1)
# Copier vers .env : cp .env.example .env

# Base (Phase 1)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/osrune
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=changeme
SUPABASE_SERVICE_ROLE=changeme

# Chroniqueur (OpenRouter)
OPENROUTER_API_KEY=
# Defaut 2026-09 : bon marche, bon JSON, francais correct. Revalider chaque trimestre.
CHRONICLER_MODEL=deepseek/deepseek-chat-v3-0324
CHRONICLER_MODEL_FALLBACK=qwen/qwen3-32b
CHRONICLER_ENABLED=true
# Prix USD par million de tokens (table locale, fait foi pour la compta)
PRICE_IN_PER_M=0.07
PRICE_OUT_PER_M=0.28

# Economie
DAY_LENGTH_HOURS_FREE=24
DAY_LENGTH_HOURS_PAID=8
GLOBAL_DAILY_CENTS_CAP=500
BUDGET_CENTS_FREE_MONTH=15
BUDGET_CENTS_PAID_MONTH=200
